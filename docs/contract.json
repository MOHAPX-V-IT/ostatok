{
  "product": "Остаток",
  "version": "0.1.0-rc.1",
  "base_url": "http://127.0.0.1:4511",
  "authorization": {
    "header": "X-API-Key",
    "value_example": "ost_<generated-secret>",
    "roles": {"reader": "GET endpoints", "operator": "reader + products/warehouses/receipts/reservations writes", "admin": "operator + API key management and manual expiry"},
    "bootstrap": "python -m ostatok.cli bootstrap --name local-admin; secret printed once, only SHA-256 stored",
    "client_scope": "A key belongs to client_id. A new key can share an existing client_id. Operators/readers see their own reservations; admins see all. Catalogue and movements are shared."
  },
  "conventions": {
    "content_type": "application/json",
    "timestamps": "UTC ISO 8601 with Z",
    "ids": "UUID strings",
    "pagination": {"query": "limit=50&offset=0", "limit": "1..100", "response": {"items": [], "total": 0, "limit": 50, "offset": 0}},
    "request_id": "X-Request-ID response header; problem.request_id",
    "idempotency": "Required Idempotency-Key (1..128 ASCII characters) on receipts, reserve, confirm, cancel. Scoped by authenticated client_id + HTTP method + concrete endpoint path. Normalized JSON fields/defaults are fingerprinted with sorted keys; changing body under a committed key gives 409. Result including status is replayed. Validation/business failures that roll back do not consume the key, except expiry discovered by confirm (expiry is committed).",
    "problem": {"type": "urn:ostatok:insufficient_stock", "title": "Недостаточно доступного остатка", "status": 409, "detail": "SKU cannot satisfy requested quantity", "request_id": "request-id", "code": "insufficient_stock"},
    "errors": {"400": "missing/invalid Idempotency-Key", "401": "missing/revoked API key", "403": "role or reservation ownership denied", "404": "unknown resource", "409": "stock/state/idempotency/unique conflict", "413": "request body exceeds 1 MiB", "422": "validation", "503": "PostgreSQL unavailable or lock timeout"}
  },
  "endpoints": [
    {"method": "GET", "path": "/health", "auth": false, "response": {"status": "ok", "version": "0.1.0-rc.1", "database": "postgresql"}},
    {"method": "GET", "path": "/api/me", "role": "reader", "response": {"key_id": "uuid", "client_id": "uuid", "name": "local-admin", "role": "admin"}},
    {"method": "GET", "path": "/api/products", "role": "reader", "query": "q optional SKU/title search; limit/offset", "response": {"items": [{"id": "uuid", "sku": "NOTE-A5", "name": "Блокнот A5", "created_at": "2026-10-18T12:00:00Z"}], "total": 1, "limit": 50, "offset": 0}},
    {"method": "POST", "path": "/api/products", "role": "operator", "body": {"sku": "NOTE-A5", "name": "Блокнот A5"}, "status": 201, "response": {"id": "uuid", "sku": "NOTE-A5", "name": "Блокнот A5", "created_at": "2026-10-18T12:00:00Z"}},
    {"method": "GET", "path": "/api/warehouses", "role": "reader", "query": "limit/offset", "response": {"items": [{"id": "uuid", "code": "MSK-01", "name": "Основной склад", "created_at": "2026-10-18T12:00:00Z"}], "total": 1, "limit": 50, "offset": 0}},
    {"method": "POST", "path": "/api/warehouses", "role": "operator", "body": {"code": "MSK-01", "name": "Основной склад"}, "status": 201, "response": {"id": "uuid", "code": "MSK-01", "name": "Основной склад", "created_at": "2026-10-18T12:00:00Z"}},
    {"method": "GET", "path": "/api/balances", "role": "reader", "query": "product_id/warehouse_id optional; limit/offset", "response": {"items": [{"product_id": "uuid", "warehouse_id": "uuid", "sku": "NOTE-A5", "product_name": "Блокнот A5", "warehouse_code": "MSK-01", "warehouse_name": "Основной склад", "available": 100, "reserved": 0, "on_hand": 100}], "total": 1, "limit": 50, "offset": 0}},
    {"method": "POST", "path": "/api/receipts", "role": "operator", "idempotency": true, "body": {"product_id": "uuid", "warehouse_id": "uuid", "quantity": 100, "reference": "DEMO-IN-001"}, "status": 201, "response": {"id": "uuid", "product_id": "uuid", "warehouse_id": "uuid", "quantity": 100, "reference": "DEMO-IN-001", "created_at": "2026-10-18T12:00:00Z"}},
    {"method": "POST", "path": "/api/reservations", "role": "operator", "idempotency": true, "body": {"order_ref": "ORDER-001", "ttl_seconds": 900, "items": [{"product_id": "uuid", "warehouse_id": "uuid", "quantity": 3}]}, "bounds": "1..50 distinct product/warehouse pairs; quantity 1..1e9; TTL 1..86400 seconds", "status": 201, "response": {"id": "uuid", "client_id": "uuid", "order_ref": "ORDER-001", "status": "active", "created_at": "2026-10-18T12:00:00Z", "expires_at": "2026-10-18T12:15:00Z", "closed_at": null, "items": [{"product_id": "uuid", "warehouse_id": "uuid", "quantity": 3, "sku": "NOTE-A5", "product_name": "Блокнот A5", "warehouse_code": "MSK-01"}]}},
    {"method": "GET", "path": "/api/reservations", "role": "reader", "query": "status=active|confirmed|cancelled|expired, order_ref optional search; limit/offset", "response": {"items": ["reservation objects as POST response"], "total": 1, "limit": 50, "offset": 0}},
    {"method": "GET", "path": "/api/reservations/{id}", "role": "reader", "response": "full reservation object"},
    {"method": "POST", "path": "/api/reservations/{id}/confirm", "role": "operator", "idempotency": true, "body": {"note": "Заказ передан в отгрузку"}, "status": 200, "response": "full reservation object with status confirmed", "errors": "expired =>409 + expiry release committed; cancelled=>409; confirmed repeated with new key=>200 no additional movement"},
    {"method": "POST", "path": "/api/reservations/{id}/cancel", "role": "operator", "idempotency": true, "body": {"note": "Отмена покупателем"}, "status": 200, "response": "full reservation object cancelled (or expired if TTL elapsed)", "errors": "confirmed=>409; already cancelled/expired=>200 no additional movement"},
    {"method": "POST", "path": "/api/maintenance/expire", "role": "admin", "body": {"limit": 100}, "response": {"expired": 0}, "note": "Server also runs expiry every5 seconds by default; CLI sweep supports manual/watch mode"},
    {"method": "GET", "path": "/api/movements", "role": "reader", "query": "product_id/warehouse_id/reservation_id optional; limit/offset", "response": {"items": [{"id": 1, "kind": "receipt", "product_id": "uuid", "warehouse_id": "uuid", "sku": "NOTE-A5", "warehouse_code": "MSK-01", "quantity": 100, "delta_available": 100, "delta_reserved": 0, "reference": "DEMO-IN-001", "reservation_id": null, "client_id": "uuid", "created_at": "2026-10-18T12:00:00Z"}], "total": 1, "limit": 50, "offset": 0}},
    {"method": "GET", "path": "/api/keys", "role": "admin", "query": "limit/offset", "response": {"items": [{"id": "uuid", "client_id": "uuid", "name": "read-only-console", "role": "reader", "created_at": "2026-10-18T12:00:00Z", "revoked_at": null}], "total": 1, "limit": 50, "offset": 0}},
    {"method": "POST", "path": "/api/keys", "role": "admin", "body": {"name": "read-only-console", "role": "reader", "client_id": "optional-existing-client-uuid"}, "status": 201, "response": {"id": "uuid", "client_id": "uuid", "name": "read-only-console", "role": "reader", "secret": "ost_<shown-once>", "created_at": "2026-10-18T12:00:00Z", "revoked_at": null}},
    {"method": "DELETE", "path": "/api/keys/{id}", "role": "admin", "status": 204, "errors": "last active admin cannot be revoked:409"}
  ]
}
